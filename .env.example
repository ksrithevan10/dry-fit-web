# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Every variable is optional for local development: without them the quote form
# logs submissions to the terminal and still shows the thank-you page.

# Public base URL, used for canonical links, sitemap and Open Graph.
# Local: http://localhost:3000 · Production: https://dry-fit.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key, used to send quote emails (server only).
RESEND_API_KEY=

# Inbox that receives new quote requests (server only).
LEADS_EMAIL=

# Sender address for outgoing emails. Must be on a domain verified in Resend,
# for example "Dry-Fit <quotes@dry-fit.com>" (server only).
EMAIL_FROM=

# Cloudflare Turnstile site key. Public by design: it is rendered in the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key, used to verify the form token (server only).
TURNSTILE_SECRET_KEY=

# Vercel Blob read/write token, used for kitchen plan uploads (server only).
# Set automatically on Vercel when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
